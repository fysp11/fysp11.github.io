---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

const activeProjects = await getProjects()

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/public/images/projects/*.{jpeg,jpg,png,webp}"
)

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    let optimizedImage = p.data.heroImage
    let optimizedListImage = p.data.heroImage

    const globKey = `/public${p.data.heroImage}`

    if (images[globKey]) {
      const resolvedImage = await images[globKey]()

      const gridOpt = await getImage({
        src: resolvedImage.default,
        width: 800,
        height: 600,
        format: "webp"
      })
      optimizedImage = gridOpt.src

      const listOpt = await getImage({
        src: resolvedImage.default,
        width: 80,
        height: 80,
        format: "webp"
      })
      optimizedListImage = listOpt.src
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      image: optimizedImage,
      listImage: optimizedListImage,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
