---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"

export const prerender = true

const activeProjects = await getProjects()

const images = import.meta.glob<{ default: ImageMetadata }>("/public/images/projects/*.{jpeg,jpg,png,webp}")

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    let optimizedImage = p.data.heroImage

    const imagePath = p.data.heroImage.replace(/^\//, "/public/")

    if (images[imagePath]) {
      const resolvedImage = await images[imagePath]()
      const optimized = await getImage({ src: resolvedImage.default, width: 800 })
      optimizedImage = optimized.src
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      image: optimizedImage,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
