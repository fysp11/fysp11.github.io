---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

const activeProjects = await getProjects()
const localImages = import.meta.glob<{ default: ImageMetadata }>("/public/images/projects/*")

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    let optimizedImageSrc = p.data.heroImage
    const isLocal = p.data.heroImage.startsWith("/images/projects/")

    if (isLocal) {
      const globKey = `/public${p.data.heroImage}`
      if (localImages[globKey]) {
        const mod = await localImages[globKey]()
        const optimized = await getImage({ src: mod.default, width: 800, height: 600 })
        optimizedImageSrc = optimized.src
      }
    } else {
      const optimized = await getImage({ src: p.data.heroImage, width: 800, height: 600 })
      optimizedImageSrc = optimized.src
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      image: optimizedImageSrc,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
