---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

const activeProjects = await getProjects()

const images = import.meta.glob<{ default: ImageMetadata }>("/public/images/projects/*.{jpeg,jpg,png,webp}")


const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    let thumbnail = p.data.heroImage;
    const imagePath = `/public${p.data.heroImage}`;
    if (images[imagePath]) {
      const imgMod = await images[imagePath]();
      const optimized = await getImage({ src: imgMod.default, width: 80, height: 80, format: "webp" });
      thumbnail = optimized.src;
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      image: p.data.heroImage,
      thumbnail,
      description: p.data.description
    };
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
