---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

const activeProjects = await getProjects()

const images = import.meta.glob<{ default: ImageMetadata }>("/public/images/projects/*.{jpeg,jpg,png,gif,webp}")

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    let gridImageUrl = p.data.heroImage
    let listImageUrl = p.data.heroImage

    // Ensure the image path exists in our glob
    const globKey = p.data.heroImage.replace("/images", "/public/images")
    if (images[globKey]) {
      const imgData = await images[globKey]()

      const gridOptimized = await getImage({
        src: imgData.default,
        width: 800,
        height: 600,
        format: "webp"
      })
      gridImageUrl = gridOptimized.src

      const listOptimized = await getImage({
        src: imgData.default,
        width: 80,
        height: 80,
        format: "webp"
      })
      listImageUrl = listOptimized.src
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      gridImage: gridImageUrl,
      listImage: listImageUrl,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
