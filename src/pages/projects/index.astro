---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"
import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"

export const prerender = true

const activeProjects = await getProjects()

const images = import.meta.glob<{ default: ImageMetadata }>("/public/images/projects/*")

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    let gridImage = p.data.heroImage
    let listImage = p.data.heroImage

    // Resolve the image metadata if it's in the public directory.
    // Performance Optimization: Pre-computing optimized WebP images on the server side
    // reduces the payload size and avoids React hydration issues when using Astro <Image>.
    if (p.data.heroImage.startsWith("/images/projects/")) {
      const globKey = "/public" + p.data.heroImage
      const imageModule = images[globKey]

      if (imageModule) {
        const imageMetadata = (await imageModule()).default

        const optimizedGrid = await getImage({ src: imageMetadata, width: 800, format: "webp" })
        gridImage = optimizedGrid.src

        const optimizedList = await getImage({ src: imageMetadata, width: 80, format: "webp" })
        listImage = optimizedList.src
      }
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      gridImage,
      listImage,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
