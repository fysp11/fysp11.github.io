---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

const images = import.meta.glob<{ default: ImageMetadata }>("/public/images/**/*")

const activeProjects = await getProjects()

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    let listImage = p.data.heroImage
    let gridImage = p.data.heroImage
    if (p.data.heroImage.startsWith("/images/")) {
      const globPath = `/public${p.data.heroImage}`
      if (images[globPath]) {
        const mod = await images[globPath]()
        const listOpt = await getImage({ src: mod.default, width: 80, height: 80, format: "webp" })
        const gridOpt = await getImage({ src: mod.default, width: 800, height: 600, format: "webp" })
        listImage = listOpt.src
        gridImage = gridOpt.src
      }
    }
    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      image: p.data.heroImage,
      listImage,
      gridImage,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
