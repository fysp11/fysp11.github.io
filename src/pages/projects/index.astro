---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"

export const prerender = true

const activeProjects = await getProjects()

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    const optimizedGridImage = await getImage({
      src: p.data.heroImage,
      width: 800,
      height: 600,
      format: "webp"
    })
    const optimizedListImage = await getImage({
      src: p.data.heroImage,
      width: 80,
      height: 80,
      format: "webp"
    })

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      imageGrid: optimizedGridImage.src,
      imageList: optimizedListImage.src,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
