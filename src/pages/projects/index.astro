---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

const activeProjects = await getProjects()

const allImages = import.meta.glob<{ default: ImageMetadata }>("/public/images/projects/*")

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    let imageGridUrl = p.data.heroImage
    let imageListUrl = p.data.heroImage

    if (p.data.heroImage.startsWith("/images/projects/")) {
      const globKey = `/public${p.data.heroImage}`
      if (allImages[globKey]) {
        const imageModule = await allImages[globKey]()
        const imageGrid = await getImage({ src: imageModule.default, width: 800, height: 600, format: "webp" })
        const imageList = await getImage({ src: imageModule.default, width: 80, height: 80, format: "webp" })
        imageGridUrl = imageGrid.src
        imageListUrl = imageList.src
      }
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      imageGridUrl,
      imageListUrl,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
