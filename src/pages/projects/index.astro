---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"

export const prerender = true

const activeProjects = await getProjects()

// ⚡ Bolt: Resolve public images to ImageMetadata at build time for optimal getImage() processing
const imageGlob = import.meta.glob<{ default: ImageMetadata }>('/public/images/projects/*.{jpeg,jpg,png,webp}')

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    const imagePath = `/public${p.data.heroImage}`
    let optimizedGridImage = p.data.heroImage
    let optimizedListImage = p.data.heroImage

    // ⚡ Bolt: Pre-compute optimized images at the server level to pass to the React component
    if (imageGlob[imagePath]) {
      const resolvedImage = (await imageGlob[imagePath]()).default
      const gridImg = await getImage({ src: resolvedImage, width: 800, height: 600 })
      const listImg = await getImage({ src: resolvedImage, width: 80, height: 80 })
      optimizedGridImage = gridImg.src
      optimizedListImage = listImg.src
    } else {
      // Fallback for string paths requiring width and height
      const gridImg = await getImage({ src: p.data.heroImage, width: 800, height: 600 })
      const listImg = await getImage({ src: p.data.heroImage, width: 80, height: 80 })
      optimizedGridImage = gridImg.src
      optimizedListImage = listImg.src
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      image: optimizedGridImage,
      listImage: optimizedListImage,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
