---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

const activeProjects = await getProjects()

const images = import.meta.glob<{ default: ImageMetadata }>('/public/images/**/*.{jpeg,jpg,png,gif,webp}')

const projects = await Promise.all(activeProjects.map(async (p: CollectionEntry<"projects">) => {
  const imgPath = p.data.heroImage
  const resolveImage = images[`/public${imgPath}`]
  let gridImage = imgPath
  let listImage = imgPath

  if (resolveImage) {
    const resolved = await resolveImage()
    const gridImg = await getImage({ src: resolved.default, width: 800, height: 600, format: "webp" })
    const listImg = await getImage({ src: resolved.default, width: 80, height: 80, format: "webp" })
    gridImage = gridImg.src
    listImage = listImg.src
  }

  return {
    name: p.data.title,
    href: `/projects/${p.data.slug}`,
    gridImage,
    listImage,
    description: p.data.description
  }
}))
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
