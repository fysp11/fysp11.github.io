---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"

export const prerender = true

const activeProjects = await getProjects()
const localImages = import.meta.glob<{ default: import('astro').ImageMetadata }>('/public/images/projects/*')

const projects = await Promise.all(activeProjects.map(async (p: CollectionEntry<"projects">) => {
  let gridImage = p.data.heroImage;
  let listImage = p.data.heroImage;

  if (p.data.heroImage.startsWith('/images/projects/')) {
    const imagePath = `/public${p.data.heroImage}`;
    if (localImages[imagePath]) {
      const imageMetadata = (await localImages[imagePath]()).default;
      const gridOpt = await getImage({ src: imageMetadata, width: 800, height: 600, format: 'webp' });
      const listOpt = await getImage({ src: imageMetadata, width: 80, height: 80, format: 'webp' });
      gridImage = gridOpt.src;
      listImage = listOpt.src;
    }
  }

  return {
    name: p.data.title,
    href: `/projects/${p.data.slug}`,
    gridImage,
    listImage,
    description: p.data.description
  };
}))
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
