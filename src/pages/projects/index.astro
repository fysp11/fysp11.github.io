---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"

import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

const activeProjects = await getProjects()
const images = import.meta.glob<{ default: ImageMetadata }>('/public/images/projects/*.{jpeg,jpg,png,webp,gif}')

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    const imagePath = `/public${p.data.heroImage}`
    let optimizedImageUrl = p.data.heroImage

    if (images[imagePath]) {
      const imageModule = await images[imagePath]()
      const optimizedImage = await getImage({ src: imageModule.default, format: 'webp', width: 800 })
      optimizedImageUrl = optimizedImage.src
    } else {
      // Fallback if not found in glob
      const optimizedImage = await getImage({ src: p.data.heroImage, width: 800, height: 600, format: 'webp' })
      optimizedImageUrl = optimizedImage.src
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      image: optimizedImageUrl,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
