---
import Layout from "@/layouts/Layout.astro"
import ProjectsView from "@/components/ProjectsView.tsx"

import type { CollectionEntry } from "astro:content"
import { getProjects } from "@/server/data"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"

export const prerender = true

const activeProjects = await getProjects()

const images = import.meta.glob<{ default: ImageMetadata }>("/public/images/**/*")

const projects = await Promise.all(
  activeProjects.map(async (p: CollectionEntry<"projects">) => {
    let imageSrc = p.data.heroImage
    let listImageSrc = p.data.heroImage

    if (imageSrc.startsWith("/")) {
      const imagePath = `/public${imageSrc}`
      if (images[imagePath]) {
        const mod = await images[imagePath]()
        const optimizedGridImage = await getImage({ src: mod.default, width: 800, height: 600, format: "webp" })
        imageSrc = optimizedGridImage.src

        const optimizedListImage = await getImage({ src: mod.default, width: 80, height: 80, format: "webp" })
        listImageSrc = optimizedListImage.src
      }
    }

    return {
      name: p.data.title,
      href: `/projects/${p.data.slug}`,
      image: imageSrc,
      listImage: listImageSrc,
      description: p.data.description
    }
  })
)
---

<Layout title="Projects">
  <ProjectsView projects={projects} client:load />
</Layout>
