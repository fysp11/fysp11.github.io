---
import type { IRecomendoItem } from "@/lib/types"
import SectionTitle from "@/components/ui/SectionTitle.astro"

interface Props {
  items: IRecomendoItem[]
}

const { items } = Astro.props

const categoryOrder = ["reading", "tools", "links"]
const categoryLabels: Record<string, string> = {
  reading: "Reading",
  tools: "Tools",
  links: "Links"
}

const grouped = categoryOrder.reduce<Record<string, IRecomendoItem[]>>((acc, cat) => {
  acc[cat] = items.filter((item) => item.category === cat)
  return acc
}, {})
---

<div class="flex flex-col gap-8">
  <SectionTitle>Recomendo</SectionTitle>
  <p class="text-muted-foreground -mt-6 text-sm leading-relaxed">
    Things I genuinely recommend — books, tools, and links worth your time.
  </p>

  {
    categoryOrder.map((cat) =>
      grouped[cat].length > 0 ? (
        <section class="flex flex-col gap-3">
          <h2 class="text-foreground text-lg font-semibold capitalize tracking-wide">
            {categoryLabels[cat] ?? cat}
          </h2>
          <ul class="flex flex-col gap-3">
            {grouped[cat].map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group border-border hover:border-accent hover:bg-accent/5 flex flex-col gap-1 rounded-lg border px-4 py-3 transition-colors"
                >
                  <div class="flex items-baseline gap-2">
                    <span class="text-foreground font-medium group-hover:underline">{item.title}</span>
                    {item.author && (
                      <span class="text-muted-foreground text-xs">by {item.author}</span>
                    )}
                  </div>
                  <p class="text-muted-foreground text-sm leading-snug">{item.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    )
  }
</div>
